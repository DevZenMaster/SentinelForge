# SentinelForge Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# NEVER commit actual secrets to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="SentinelForge"
API_V1_STR="/api/v1"

# Security & Session Authentication
# In production, generate with: openssl rand -hex 32
SECRET_KEY=dev-insecure-secret-key-must-be-changed-in-production-0987654321
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinelforge
POSTGRES_PASSWORD=sentinel_dev_password_change_me
POSTGRES_DB=sentinelforge_db

# Async Database URI (Constructed automatically in config if omitted)
# DATABASE_URL=postgresql+asyncpg://sentinelforge:sentinel_dev_password_change_me@localhost:5432/sentinelforge_db

# Rate Limiting & Abuse Prevention
AUTH_RATE_LIMIT_PER_MINUTE=10
EVENTS_RATE_LIMIT_PER_MINUTE=1000

# CORS Configuration (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
