# ==============================================================================
# SentinelForge Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local or production environment.
# NEVER commit the actual .env file or sensitive secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="SentinelForge"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Cryptographic & Security Keys
# ------------------------------------------------------------------------------
# In production, generate a cryptographically secure key (minimum 32 characters):
# openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ------------------------------------------------------------------------------
# Session Cookie & CSRF Security Settings
# ------------------------------------------------------------------------------
SESSION_COOKIE_NAME=sentinelforge_session
# Set SESSION_COOKIE_SECURE to true in production (requires HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_EXPIRE_HOURS=12
CSRF_PROTECTION_ENABLED=true

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinelforge
POSTGRES_PASSWORD=sentinel_dev_password_change_me
POSTGRES_DB=sentinelforge_db

# Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Optional Async Database URL Override (constructed automatically if omitted)
# DATABASE_URL=postgresql+asyncpg://sentinelforge:sentinel_dev_password_change_me@localhost:5432/sentinelforge_db

# ------------------------------------------------------------------------------
# Reverse Proxy & Edge Security
# ------------------------------------------------------------------------------
# List of trusted reverse proxy IP addresses for client IP extraction
TRUSTED_PROXIES=["127.0.0.1","::1"]

# ------------------------------------------------------------------------------
# CORS Origins (JSON list or comma-separated strings)
# ------------------------------------------------------------------------------
# Wildcard '*' is strictly prohibited in production environments
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Rate Limiting & Ingestion Controls
# ------------------------------------------------------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=10
EVENTS_RATE_LIMIT_PER_MINUTE=1000
MAX_EVENT_PAYLOAD_BYTES=1048576

# ------------------------------------------------------------------------------
# Security Notifications & Webhook Integrations
# ------------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
WEBHOOK_TIMEOUT_SECONDS=10.0
WEBHOOK_CONNECT_TIMEOUT_SECONDS=5.0
WEBHOOK_MAX_PAYLOAD_BYTES=65536
WEBHOOK_MAX_RESPONSE_BYTES=16384
WEBHOOK_ALLOW_INSECURE_HTTP=false
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_MAX_DESTINATIONS_PER_POLICY=10
NOTIFICATION_BASE_BACKOFF_SECONDS=5
NOTIFICATION_MAX_BACKOFF_SECONDS=300

# Optional SMTP Email Notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASSWORD=your_secure_smtp_password
# SMTP_FROM_EMAIL=notifications@sentinelforge.local
# SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# Frontend Application Configuration (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal API URL for server-side Next.js rewrites within container networks
# API_INTERNAL_URL=http://api:8000/api/:path*
